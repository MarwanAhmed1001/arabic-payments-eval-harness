# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and insert your local configuration.
# DO NOT COMMIT THE ACTUAL .env FILE OR ANY PRIVATE KEYS TO VERSION CONTROL.
# ==============================================================================

# Execution Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Optional: External LLM Provider API Keys (leave empty for local regex/rule baseline)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Evaluation Settings
EVAL_BATCH_SIZE=16
EVAL_RANDOM_SEED=42
ENABLE_STRICT_NORMALIZATION=true
